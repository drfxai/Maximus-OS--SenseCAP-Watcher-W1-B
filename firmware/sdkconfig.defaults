# Maximus OS - SenseCAP Watcher W1-B (ESP32-S3, 32 MB flash, 8 MB octal PSRAM)
CONFIG_IDF_TARGET="esp32s3"

# Flash
CONFIG_BOOTLOADER_CACHE_32BIT_ADDR_QUAD_FLASH=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# CPU / PSRAM / caches (big caches matter a lot for LVGL drawing from PSRAM)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=262144
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPI_MASTER_IN_IRAM=y

# System
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_ESP_INT_WDT_TIMEOUT_MS=10000
CONFIG_FATFS_LFN_STACK=y
# a crash leaves its summary (task, address, backtrace) in the coredump
# partition; the web console shows it after the restart
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y

# Console on UART0: the USB-C socket goes through a CH342 USB-serial bridge
# to UART0 (the factory firmware does the same). The web installer talks to it
# there. The native USB port mirrors the output as a second console.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# Wi-Fi / TLS
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_LWIP_LOCAL_HOSTNAME="maximus"
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_ESP_TLS_USING_MBEDTLS=y

# LVGL 8
CONFIG_LV_COLOR_16_SWAP=y
CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_MEM_BUF_MAX_NUM=32
CONFIG_LV_IMG_CACHE_DEF_SIZE=2
CONFIG_LV_USE_PNG=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_40=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_16=y
CONFIG_LV_USE_SHADOW=y
CONFIG_LV_USE_TEXTAREA=y
# No gradient dithering (the factory firmware has none): the error diffusion
# pattern showed as fine vertical streaks on gradients.
CONFIG_LV_DITHER_GRADIENT=n
# ~60 fps redraw; touch read every 20 ms, which the touch controller keeps up
# with (every 10 ms it repeated stale or glitched points)
CONFIG_LV_DISP_DEF_REFR_PERIOD=16
CONFIG_LV_INDEV_DEF_READ_PERIOD=20
CONFIG_LV_INDEV_DEF_SCROLL_LIMIT=8
CONFIG_LV_INDEV_DEF_GESTURE_LIMIT=40
CONFIG_LV_INDEV_DEF_GESTURE_MIN_VELOCITY=2

# Board support package
# do not abort when an optional part (SD card, camera chip) is missing
CONFIG_BSP_ERROR_CHECK=n
CONFIG_BSP_LCD_DEFAULT_BRIGHTNESS=0
# same queue depth as the factory firmware
CONFIG_BSP_LCD_PANEL_SPI_TRANS_Q_DEPTH=1
CONFIG_BSP_LCD_SPI_DMA_SIZE_DIV=16
CONFIG_LVGL_PORT_TASK_PRIORITY=11
CONFIG_LVGL_PORT_TASK_AFFINITY_CPU1=y
CONFIG_LVGL_PORT_TASK_STACK_ALLOC_EXTERNAL=y
# the default 10 KB was close to full on the busiest screens
CONFIG_LVGL_PORT_TASK_STACK_SIZE=16384
CONFIG_LVGL_PORT_TASK_MAX_SLEEP_MS=2
CONFIG_LVGL_PORT_TIMER_PERIOD_MS=2
# Maximus handles the knob itself (rotate/confirm/5 s/10 s); touch stays on LVGL
CONFIG_LVGL_INPUT_DEVICE_USE_KNOB=n
CONFIG_LVGL_INPUT_DEVICE_USE_TP=y
# no strength filter: the old threshold of 20 dropped light touches
CONFIG_LVGL_INPUT_DEVICE_SENSITIVITY=-1
CONFIG_SSCMA_EVENT_QUEUE_SIZE=1
CONFIG_SSCMA_RX_BUFFER_SIZE=131072
CONFIG_SSCMA_PROCESS_TASK_STACK_SIZE=10240
CONFIG_SSCMA_PROCESS_TASK_AFFINITY_CPU1=y
CONFIG_SSCMA_PROCESS_TASK_STACK_ALLOC_EXTERNAL=y

# Bluetooth LE (peripheral only: advertise "Maximus OS" when switched on)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n

